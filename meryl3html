
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>We Will Chop You</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        #top-nav {
            transition: transform 0.3s ease-in-out;
        }
        #top-nav.nav-hidden {
            transform: translateY(-100%);
        }
    </style>
</head>
<body class="bg-black text-slate-100">

    <nav id="top-nav" class="bg-slate-900/90 backdrop-blur-sm sticky top-0 z-50 shadow-lg">
        <div class="max-w-4xl mx-auto px-4 py-3 relative flex items-center justify-center">
             <a href="javascript:history.back()" title="Go Back" class="absolute left-4 top-1/2 -translate-y-1/2 flex items-center text-slate-300 hover:text-sky-400 transition-colors group">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 mr-1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                </svg>
                <span class="hidden sm:inline">Back</span>
            </a>
            <h1 class="text-xl md:text-2xl font-bold text-sky-400 text-center truncate px-16 sm:px-20">We Will Chop You</h1>
        </div>
    </nav>

    <main class="max-w-xl mx-auto">
        <img src="data:image/jpeg;base64," alt="Page 1" class="w-full h-auto block"><img src="data:image/jpeg;base64," alt="Page 2" class="w-full h-auto block"><img src="data:image/jpeg;base64," alt="Page 3" class="w-full h-auto block"><img src="data:image/jpeg;base64," alt="Page 4" class="w-full h-auto block"><img src="data:image/jpeg;base64," alt="Page 5" class="w-full h-auto block"><img src="data:image/jpeg;base64," alt="Page 6" class="w-full h-auto block">
    </main>
    
    <footer class="mt-10 py-6 text-center text-slate-500 text-sm border-t border-slate-800">
        <p>Generated with LoreMaster AI.</p>
    </footer>

    <script>
        let lastScrollY = window.scrollY;
        const nav = document.getElementById('top-nav');

        if (nav) {
            const handleScroll = () => {
                if (window.scrollY > lastScrollY && window.scrollY > nav.offsetHeight) {
                    // Scrolling down
                    nav.classList.add('nav-hidden');
                } else {
                    // Scrolling up
                    nav.classList.remove('nav-hidden');
                }
                lastScrollY = window.scrollY;
            };

            window.addEventListener('scroll', handleScroll, { passive: true });
        }
    </script>
</body>
</html>
    
